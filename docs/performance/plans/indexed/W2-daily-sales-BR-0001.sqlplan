<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH PaidSales AS&#xd;&#xa;    (&#xd;&#xa;        SELECT t.CounterTransactionId, t.Tax&#xd;&#xa;        FROM dbo.CounterTransactions AS t&#xd;&#xa;        WHERE t.BranchCode = @BranchCode&#xd;&#xa;          AND t.Status = &apos;Paid&apos;&#xd;&#xa;          AND t.OccurredAtUtc &gt;= @From&#xd;&#xa;          AND t.OccurredAtUtc &lt; @To&#xd;&#xa;    ),&#xd;&#xa;    LineTotals AS&#xd;&#xa;    (&#xd;&#xa;        SELECT&#xd;&#xa;            SUM(CASE WHEN l.ProductCode IS NOT NULL THEN l.UnitPrice * l.Quantity ELSE 0 END) AS RetailSales,&#xd;&#xa;            SUM(CASE WHEN l.ProductCode IS NULL THEN l.UnitPrice * l.Quantity ELSE 0 END) AS ServiceSales&#xd;&#xa;        FROM dbo.TransactionLines AS l&#xd;&#xa;        INNER JOIN PaidSales AS p ON p.CounterTransactionId = l.CounterTransactionId&#xd;&#xa;    )&#xd;&#xa;    SELECT&#xd;&#xa;        @BranchCode AS BranchCode,&#xd;&#xa;        @Date AS SalesDate,&#xd;&#xa;        CAST(ISNULL(lt.RetailSales, 0) AS decimal(18, 2)) AS RetailSales,&#xd;&#xa;        CAST(ISNULL(lt.ServiceSales, 0) AS decimal(18, 2)) AS ServiceSales,&#xd;&#xa;        CAST(ISNULL((SELECT SUM(p.Tax) FROM PaidSales AS p), 0) AS decimal(18, 2)) AS Tax,&#xd;&#xa;        (SELECT COUNT(*) FROM PaidSales) AS PaidTransactionCount&#xd;&#xa;    FROM LineTotals AS lt" StatementId="2" StatementCompId="15" StatementType="SELECT" StatementSqlHandle="0x090027722BA0E49954CABF42C3194F8C12180000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="1442104178" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="5.39444" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x6CE73AEF1EA84CC3" QueryPlanHash="0x291F6868DA432D8E" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDEN