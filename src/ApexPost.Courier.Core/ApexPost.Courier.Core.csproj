<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The courier app's logic without a user interface: the typed v2 API client with its token handler and resilience
    pipeline, the uploader, automatic sync and the sign-in session (ADR 0032). The console app uses it today and the
    MAUI app will use it later; each supplies only its screens, its token store and its network status.
  -->

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Courier.Offline\ApexPost.Courier.Offline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApexPost.Courier.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
