# ApexPost tracking API (Week 4, Part B): one success and at least one failure request per endpoint.
# Open in Visual Studio or VS Code (REST Client) and send the requests top to bottom; later requests use the
# shipments the earlier ones create. Start the API first: dotnet run --project src/ApexPost.Api --launch-profile http
# The tracking numbers below must not exist yet. On a database that already has them, change the two variables.
# All data is fictional.

@host = http://localhost:5245
@trackingNumber = APX-24100001
@deletableNumber = APX-24100002

### Health check -> 200
GET {{host}}/health

### 1. POST /api/shipments: create -> 201 Created, Location: /api/shipments/APX-24100001
POST {{host}}/api/shipments
Content-Type: application/json

{
  "trackingNumber": "{{trackingNumber}}",
  "recipientName": "Ama Mensah",
  "recipientPhone": "+44 20 7946 0000",
  "recipientAddress": "12 Harbour Road",
  "city": "Portside",
  "weightKg": 4.25
}

### 1. POST /api/shipments: the same tracking number again -> 409 Conflict
POST {{host}}/api/shipments
Content-Type: application/json

{
  "trackingNumber": "{{trackingNumber}}",
  "recipientName": "Ama Mensah",
  "recipientPhone": "+44 20 7946 0000",
  "recipientAddress": "12 Harbour Road",
  "city": "Portside",
  "weightKg": 4.25
}

### 1. POST /api/shipments: invalid values -> 400 ValidationProblemDetails (tracking number, phone, weight, missing city)
POST {{host}}/api/shipments
Content-Type: application/json

{
  "trackingNumber": "APX-123",
  "recipientName": "Ama Mensah",
  "recipientPhone": "020 7946 0000 ext 5",
  "recipientAddress": "12 Harbour Road",
  "weightKg": 70.5
}

### 1. POST /api/shipments: not JSON -> 415 Unsupported Media Type
POST {{host}}/api/shipments
Content-Type: text/plain

trackingNumber=APX-24100009

### 2. GET /api/shipments/{trackingNumber} -> 200 OK
GET {{host}}/api/shipments/{{trackingNumber}}

### 2. GET /api/shipments/{trackingNumber}: unknown -> 404 Not Found
GET {{host}}/api/shipments/APX-99999999

### 2. GET /api/shipments/{trackingNumber}: not a tracking number -> 404 (the route constraint never matches)
GET {{host}}/api/shipments/12345

### 3. GET /api/shipments: page 1, 20 per page, filtered by status and city -> 200 OK
GET {{host}}/api/shipments?page=1&pageSize=20&status=Created&city=Portside

### 3. GET /api/shipments: pageSize above 50 -> 400
GET {{host}}/api/shipments?pageSize=51

### 4. PUT /api/shipments/{trackingNumber}: replace the editable details -> 200 OK
PUT {{host}}/api/shipments/{{trackingNumber}}
Content-Type: application/json

{
  "recipientName": "Kofi Mensah",
  "recipientPhone": "(020) 7946-0001",
  "recipientAddress": "3 Quay Street",
  "city": "Portside",
  "weightKg": 4.5
}

### 4. PUT /api/shipments/{trackingNumber}: invalid phone and weight -> 400
PUT {{host}}/api/shipments/{{trackingNumber}}
Content-Type: application/json

{
  "recipientName": "Kofi Mensah",
  "recipientPhone": "12",
  "recipientAddress": "3 Quay Street",
  "city": "Portside",
  "weightKg": 0
}

### 4. PUT /api/shipments/{trackingNumber}: unknown -> 404
PUT {{host}}/api/shipments/APX-99999999
Content-Type: application/json

{
  "recipientName": "Kofi Mensah",
  "recipientPhone": "(020) 7946-0001",
  "recipientAddress": "3 Quay Street",
  "city": "Portside",
  "weightKg": 4.5
}

### 5. PATCH /api/shipments/{trackingNumber}/status: Created -> PickedUp -> 200 OK
PATCH {{host}}/api/shipments/{{trackingNumber}}/status
Content-Type: application/json

{ "status": "PickedUp" }

### 5. PATCH /api/shipments/{trackingNumber}/status: skipping to Delivered -> 409 Conflict (names the allowed next status)
PATCH {{host}}/api/shipments/{{trackingNumber}}/status
Content-Type: application/json

{ "status": "Delivered" }

### 5. PATCH /api/shipments/{trackingNumber}/status: unknown status -> 400
PATCH {{host}}/api/shipments/{{trackingNumber}}/status
Content-Type: application/json

{ "status": "Lost" }

### 6. POST /api/shipments/{trackingNumber}/scans: offline scans -> 200 OK, accepted 2 (status moves to InTransit), rejected 1 with the reason
POST {{host}}/api/shipments/{{trackingNumber}}/scans
Content-Type: application/json

{
  "scans": [
    { "scanId": "scan::0199a001-0000-7000-8000-000000000001", "scanType": "Pickup", "location": "Riverside Depot", "courierId": "CR-001", "scannedAtUtc": "2026-11-01T08:00:00Z", "notes": "Collected from front desk" },
    { "scanId": "scan::0199a001-0000-7000-8000-000000000002", "scanType": "InTransit", "location": "Central Sorting, Belt 4", "courierId": "CR-001", "scannedAtUtc": "2026-11-01T11:30:00Z" },
    { "scanId": "scan::0199a001-0000-7000-8000-000000000003", "scanType": "Delivered", "location": "12 Harbour Road", "courierId": "CR-001", "scannedAtUtc": "2026-11-01T15:00:00Z" }
  ]
}

### 6. POST /api/shipments/{trackingNumber}/scans: the same upload again -> 200 OK, accepted 0, duplicatesSkipped 2 (idempotent)
POST {{host}}/api/shipments/{{trackingNumber}}/scans
Content-Type: application/json

{
  "scans": [
    { "scanId": "scan::0199a001-0000-7000-8000-000000000001", "scanType": "Pickup", "location": "Riverside Depot", "courierId": "CR-001", "scannedAtUtc": "2026-11-01T08:00:00Z", "notes": "Collected from front desk" },
    { "scanId": "scan::0199a001-0000-7000-8000-000000000002", "scanType": "InTransit", "location": "Central Sorting, Belt 4", "courierId": "CR-001", "scannedAtUtc": "2026-11-01T11:30:00Z" },
    { "scanId": "scan::0199a001-0000-7000-8000-000000000003", "scanType": "Delivered", "location": "12 Harbour Road", "courierId": "CR-001", "scannedAtUtc": "2026-11-01T15:00:00Z" }
  ]
}

### 6. POST /api/shipments/{trackingNumber}/scans: a scan time in the future -> 400 (custom rule, key scans[0].scannedAtUtc)
POST {{host}}/api/shipments/{{trackingNumber}}/scans
Content-Type: application/json

{
  "scans": [
    { "scanId": "scan::0199a001-0000-7000-8000-000000000004", "scanType": "Delivered", "location": "12 Harbour Road", "courierId": "CR-001", "scannedAtUtc": "2099-01-01T08:00:00Z" }
  ]
}

### 6. POST /api/shipments/{trackingNumber}/scans: unknown shipment -> 404
POST {{host}}/api/shipments/APX-99999999/scans
Content-Type: application/json

{
  "scans": [
    { "scanId": "scan::0199a001-0000-7000-8000-000000000005", "scanType": "Pickup", "location": "Riverside Depot", "courierId": "CR-001", "scannedAtUtc": "2026-11-01T08:00:00Z" }
  ]
}

### 7. GET /api/shipments/{trackingNumber}/scans: history, oldest first -> 200 OK
GET {{host}}/api/shipments/{{trackingNumber}}/scans

### 7. GET /api/shipments/{trackingNumber}/scans: unknown shipment -> 404
GET {{host}}/api/shipments/APX-99999999/scans

### 8. DELETE /api/shipments/{trackingNumber}: already InTransit -> 409 Conflict
DELETE {{host}}/api/shipments/{{trackingNumber}}

### 8. DELETE: create a second shipment to delete -> 201
POST {{host}}/api/shipments
Content-Type: application/json

{
  "trackingNumber": "{{deletableNumber}}",
  "recipientName": "Esi Owusu",
  "recipientPhone": "0207946002",
  "recipientAddress": "7 Mill Lane",
  "city": "Rivermouth",
  "weightKg": 0.8
}

### 8. DELETE /api/shipments/{trackingNumber}: still Created -> 204 No Content
DELETE {{host}}/api/shipments/{{deletableNumber}}

### 8. DELETE /api/shipments/{trackingNumber}: already deleted -> 404
DELETE {{host}}/api/shipments/{{deletableNumber}}
