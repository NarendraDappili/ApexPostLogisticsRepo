<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Application\ApexPost.Application.csproj" />
    <ProjectReference Include="..\ApexPost.Infrastructure\ApexPost.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApexPost.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The XML comments on actions and DTOs become the summaries and descriptions in the OpenAPI document. A public
         member without one is a build warning (CS1591), so the document never silently loses a description. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1573 asks for a <param> on every parameter once one is documented. An action's CancellationToken is not
         part of the HTTP contract, and the .NET 10 generator put its <param> text on the request body. -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <!-- AV0029/AV0030 (Asp.Versioning analyzers) recommend its OpenAPI integration package. Measured against our v1
         document, that package drops the request body descriptions, every <example> and the numeric enums' field
         descriptions, because it replaces the .NET XML-comment generator. The documents are built with the built-in
         AddOpenApi per version instead, selected by the API Explorer group names v1 and v2 (VERSIONING.md). -->
    <NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
    <!-- The UserSecretsId of ApexPost.Web: the API works on the same database, so both read the one
         ConnectionStrings:ApexPostDb secret (as the design-time DbContext factory already does). -->
    <UserSecretsId>c64b2003-9f07-4be4-801b-323af9da40c8</UserSecretsId>
  </PropertyGroup>

</Project>
