{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApexPost": {
    "DataDirectory": "App_Data",
    "Inventory": {
      "LowStockThreshold": 10,
      "LowStockRecipient": "operations-alerts@example.test"
    },
    "MoneyOrders": {
      "HighValueThreshold": 1000.00
    },
    "Transactions": {
      "TaxRate": 0.00
    },
    "Performance": {
      "WarningThresholdMilliseconds": 500
    },
    "Authentication": {
      "DemoAccounts": {}
    },
    "Maintenance": {
      "Enabled": false,
      "RetryAfterSeconds": 300
    },
    "Security": {
      "Integration": {
        "AllowedIps": []
      },
      "PartnerTrackingWidgetOrigin": "https://tracking-widget.partner.example"
    },
    "RateLimiting": {
      "LoginPermitLimit": 20,
      "IntegrationPermitLimit": 60
    }
  },
  "AllowedHosts": "*"
}
