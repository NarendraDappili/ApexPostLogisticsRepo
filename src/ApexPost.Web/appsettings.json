{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApexPost": {
    "DataDirectory": "App_Data",
    "DemoSeed": {
      "Enabled": false
    },
    "Inventory": {
      "LowStockThreshold": 10,
      "LowStockRecipient": "operations-alerts@example.test"
    },
    "MoneyOrders": {
      "HighValueThreshold": 1000.00,
      "FlatFee": 2.50,
      "FeeRate": 0.01
    },
    "Transactions": {
      "TaxRate": 0.00
    },
    "Courier": {
      "LookupTimeoutMilliseconds": 2000,
      "LatencyMilliseconds": 150,
      "MaxConcurrentLookups": 4
    },
    "Performance": {
      "WarningThresholdMilliseconds": 500
    },
    "Maintenance": {
      "Enabled": false,
      "RetryAfterSeconds": 300
    },
    "Security": {
      "Integration": {
        "AllowedIps": []
      },
      "PartnerTrackingWidgetOrigin": "https://tracking-widget.partner.example"
    },
    "RateLimiting": {
      "LoginPermitLimit": 20,
      "IntegrationPermitLimit": 60
    }
  },
  "AllowedHosts": "*"
}
