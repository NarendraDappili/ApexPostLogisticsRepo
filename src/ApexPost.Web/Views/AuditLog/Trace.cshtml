@model ApexPost.Web.Models.AuditTraceViewModel
@{
    ViewData["Title"] = "Request trace";
    var trace = Model.Trace;
}
<div class="page-header">
    <h1>Request trace</h1>
    <p class="text-muted mb-0">Everything one request left in the audit trail. Correlation ID: <code class="audit-correlation">@trace.CorrelationId</code></p>
</div>
<p><a class="btn btn-sm btn-outline-secondary" asp-action="Requests">Back to the audit log</a></p>

<section class="mb-4" aria-labelledby="trace-requests-heading">
    <h2 id="trace-requests-heading" class="h5">Request <span class="badge text-bg-secondary">@trace.Requests.Count</span></h2>
    @if (trace.Requests.Count == 0) { <p class="text-muted" role="status">No request you can read has this correlation ID.</p> }
    else { <partial name="_RequestTable" model="trace.Requests" /> }
</section>

<section class="mb-4" aria-labelledby="trace-changes-heading">
    <h2 id="trace-changes-heading" class="h5">Data changes <span class="badge text-bg-secondary">@trace.DataChanges.Count</span></h2>
    @if (trace.DataChanges.Count == 0) { <p class="text-muted" role="status">This request changed no data you can read.</p> }
    else { <partial name="_ChangeTable" model="trace.DataChanges" /> }
</section>

@if (Model.CanViewSecurityEvents)
{
    <section class="mb-4" aria-labelledby="trace-security-heading">
        <h2 id="trace-security-heading" class="h5">Security events <span class="badge text-bg-secondary">@trace.SecurityEvents.Count</span></h2>
        @if (trace.SecurityEvents.Count == 0) { <p class="text-muted" role="status">This request raised no security event.</p> }
        else { <partial name="_SecurityTable" model="trace.SecurityEvents" /> }
    </section>
}
