@model IReadOnlyList<ApexPost.Application.Auditing.RequestAuditItem>
@using ApexPost.Web.Services
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle audit-table">
        <caption>Requests, newest first. Times are UTC.</caption>
        <thead><tr><th scope="col">When (UTC)</th><th scope="col">Staff</th><th scope="col">Branch</th><th scope="col">Request</th><th scope="col">Status</th><th scope="col">Outcome</th><th scope="col" class="text-end">Duration</th><th scope="col">Trace</th></tr></thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <th scope="row" class="audit-time">@AuditDisplay.Time(row.OccurredAt)</th>
                <td><span class="d-block fw-semibold text-nowrap">@(row.StaffId ?? "Anonymous")</span>@if (row.Role is not null) { <span class="d-block small text-muted">@row.Role</span> }</td>
                <td class="text-nowrap">@row.BranchCode</td>
                <td><span class="d-block text-nowrap">@row.Controller / @row.Action</span>@if (row.RouteValues.Count > 0) { <span class="d-block audit-route">@string.Join(", ", row.RouteValues.Select(pair => $"{pair.Key}: {pair.Value}"))</span> }</td>
                <td><span class="badge @AuditDisplay.StatusBadge(row.StatusCode)">@row.StatusCode</span></td>
                <td><span class="badge @AuditDisplay.OutcomeBadge(row.Outcome)">@row.Outcome</span></td>
                <td class="text-end text-nowrap">@row.DurationMilliseconds ms</td>
                <td><a class="audit-trace-link" asp-controller="AuditLog" asp-action="Trace" asp-route-id="@row.CorrelationId" title="Everything request @row.CorrelationId left in the audit trail">@AuditDisplay.ShortId(row.CorrelationId)</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
