@model ApexPost.Web.Models.ShippingLabelViewModel
@{ ViewData["Title"] = "Shipping label preview"; }
<h1>Shipping label preview</h1>
<dl><dt>Shipment</dt><dd>@Model.Shipment.Id.Value</dd><dt>From</dt><dd>@Model.Shipment.OriginBranchCode.Value</dd><dt>Destination zone</dt><dd>@Model.Shipment.DestinationZoneCode.Value</dd><dt>Service</dt><dd>@Model.Shipment.ServiceLevel</dd><dt>Type</dt><dd>@Model.Shipment.ShipmentType</dd><dt>Weight</dt><dd>@Model.Shipment.Weight.Kilograms kg</dd>@if (Model.Charge is not null) { <dt>Charge</dt><dd>@Model.Charge.Value.ToString("0.00")</dd> }</dl>
<a class="btn btn-secondary" asp-action="Create">New shipment</a>
