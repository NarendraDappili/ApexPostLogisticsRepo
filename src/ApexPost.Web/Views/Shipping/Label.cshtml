@model ApexPost.Web.Models.ShippingLabelViewModel
@{ ViewData["Title"] = "Shipping label preview"; var label = Model.Label; }
<h1>Shipping label preview</h1>
<dl><dt>Shipment</dt><dd>@label.ShipmentId</dd><dt>From</dt><dd>@label.OriginBranchCode</dd><dt>Destination zone</dt><dd>@label.DestinationZoneCode</dd><dt>Service</dt><dd>@label.ServiceLevel</dd><dt>Type</dt><dd>@label.ShipmentType</dd><dt>Weight</dt><dd>@label.WeightKilograms.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) kg</dd>@if (Model.Charge is not null) { <dt>Charge</dt><dd>@Model.Charge.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</dd> }</dl>
@if (label.TransactionId is not null)
{
    <p role="status">Bill this shipment by adding <strong>@label.ShipmentId</strong> to the basket for transaction <strong>@label.TransactionId</strong>.</p>
    <a class="btn btn-primary" asp-controller="CounterTransactions" asp-action="New">Open counter basket</a>
}
<a class="btn btn-secondary" asp-action="Create">New shipment</a>
