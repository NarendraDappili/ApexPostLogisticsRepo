@model IReadOnlyCollection<ApexPost.Domain.Entities.Branch>
@{ ViewData["Title"] = "Branches"; }
<h1>Branches</h1>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status" aria-live="polite">@notice</div> }
<p><a class="btn btn-primary" asp-action="Create">Add branch</a></p>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <caption>All branches</caption>
        <thead><tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col">Region</th><th scope="col">Opening hours</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
        <tbody>
        @foreach (var branch in Model)
        {
            <tr>
                <th scope="row">@branch.Code.Value</th>
                <td>@branch.Name</td>
                <td>@branch.Region</td>
                <td>@branch.OpeningHours</td>
                <td>@(branch.IsOpen ? "Open" : "Closed")</td>
                <td class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@branch.Code.Value">Edit</a>
                    <form method="post" asp-action="@(branch.IsOpen ? "Close" : "Open")" asp-route-id="@branch.Code.Value">
                        <button class="btn btn-sm @(branch.IsOpen ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(branch.IsOpen ? "Close" : "Reopen")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
