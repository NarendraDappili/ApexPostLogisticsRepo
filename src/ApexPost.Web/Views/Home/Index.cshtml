@{
    ViewData["Title"] = "ApexPost counter platform";
    var homeBranch = User.FindFirst(ApexPost.Web.Security.ApexPostClaimTypes.BranchCode)?.Value;
    var canViewAllBranches = ApexPost.Web.Security.BranchAccess.CanViewAllBranches(User);
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="page-header">
        <h1>Welcome, @User.Identity.Name</h1>
        <p class="text-muted mb-0">
            @if (canViewAllBranches) { <text>You can view every branch. Your home branch is @homeBranch.</text> }
            else { <text>You work at @homeBranch. Everything you view and record here is for that branch.</text> }
        </p>
    </div>
    <div class="row g-3">
        @* Only the pages this role can open, so every shortcut leads somewhere that works. *@
        <div class="col-md-4"><div class="card shortcut h-100"><div class="card-body">
            <svg class="shortcut-icon" aria-hidden="true" focusable="false"><use href="#i-dashboard"></use></svg>
            <h2 class="h5 card-title"><a class="stretched-link" asp-controller="Branch" asp-action="Dashboard">Branch dashboard</a></h2>
            <p class="card-text text-muted small">Open counters, today's paid sales and low-stock alerts.</p>
        </div></div></div>
        <div class="col-md-4"><div class="card shortcut h-100"><div class="card-body">
            <svg class="shortcut-icon" aria-hidden="true" focusable="false"><use href="#i-box"></use></svg>
            <h2 class="h5 card-title"><a class="stretched-link" asp-controller="Catalogue" asp-action="Index">Catalogue and stock</a></h2>
            <p class="card-text text-muted small">Prices and branch stock, with low-stock products flagged.</p>
        </div></div></div>
        @if (User.IsInRole("CounterClerk"))
        {
            <div class="col-md-4"><div class="card shortcut h-100"><div class="card-body">
                <svg class="shortcut-icon" aria-hidden="true" focusable="false"><use href="#i-basket"></use></svg>
            <h2 class="h5 card-title"><a class="stretched-link" asp-controller="CounterTransactions" asp-action="New">Counter basket</a></h2>
                <p class="card-text text-muted small">Sell retail items and bill shipments and money orders in one payment.</p>
            </div></div></div>
            <div class="col-md-4"><div class="card shortcut h-100"><div class="card-body">
                <svg class="shortcut-icon" aria-hidden="true" focusable="false"><use href="#i-truck"></use></svg>
            <h2 class="h5 card-title"><a class="stretched-link" asp-controller="Shipping" asp-action="Create">Create a shipment</a></h2>
                <p class="card-text text-muted small">Accept a letter or parcel and preview its label and charge.</p>
            </div></div></div>
            <div class="col-md-4"><div class="card shortcut h-100"><div class="card-body">
                <svg class="shortcut-icon" aria-hidden="true" focusable="false"><use href="#i-money"></use></svg>
            <h2 class="h5 card-title"><a class="stretched-link" asp-controller="MoneyOrders" asp-action="Create">Issue a money order</a></h2>
                <p class="card-text text-muted small">High-value orders go to identity verification first.</p>
            </div></div></div>
        }
        @if (User.IsInRole("BranchManager"))
        {
            <div class="col-md-4"><div class="card shortcut h-100"><div class="card-body">
                <svg class="shortcut-icon" aria-hidden="true" focusable="false"><use href="#i-receipt"></use></svg>
            <h2 class="h5 card-title"><a class="stretched-link" asp-controller="CounterTransactions" asp-action="Manage">Branch transactions</a></h2>
                <p class="card-text text-muted small">Void or refund recent sales, with a reason.</p>
            </div></div></div>
        }
        @if (User.IsInRole("BranchManager") || User.IsInRole("Auditor") || User.IsInRole("Administrator"))
        {
            <div class="col-md-4"><div class="card shortcut h-100"><div class="card-body">
                <svg class="shortcut-icon" aria-hidden="true" focusable="false"><use href="#i-chart"></use></svg>
            <h2 class="h5 card-title"><a class="stretched-link" asp-controller="Reports" asp-action="Index">Branch reports</a></h2>
                <p class="card-text text-muted small">Daily sales, low stock, shipping volume and money orders.</p>
            </div></div></div>
            <div class="col-md-4"><div class="card shortcut h-100"><div class="card-body">
                <svg class="shortcut-icon" aria-hidden="true" focusable="false"><use href="#i-audit"></use></svg>
            <h2 class="h5 card-title"><a class="stretched-link" asp-controller="AuditLog" asp-action="Requests">Audit log</a></h2>
                <p class="card-text text-muted small">@(User.IsInRole("BranchManager") ? "Your branch's requests and data changes, with old and new values." : "Requests, data changes and security events for every branch.")</p>
            </div></div></div>
        }
        @if (User.IsInRole("Administrator"))
        {
            <div class="col-md-4"><div class="card shortcut h-100"><div class="card-body">
                <svg class="shortcut-icon" aria-hidden="true" focusable="false"><use href="#i-users"></use></svg>
            <h2 class="h5 card-title"><a class="stretched-link" asp-controller="StaffAdmin" asp-action="Index">Staff accounts</a></h2>
                <p class="card-text text-muted small">Add staff, change roles and home branches, deactivate accounts.</p>
            </div></div></div>
            <div class="col-md-4"><div class="card shortcut h-100"><div class="card-body">
                <svg class="shortcut-icon" aria-hidden="true" focusable="false"><use href="#i-building"></use></svg>
            <h2 class="h5 card-title"><a class="stretched-link" asp-controller="BranchAdmin" asp-action="Index">Branch administration</a></h2>
                <p class="card-text text-muted small">Add branches, edit their details, open or close them.</p>
            </div></div></div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <h1 class="display-5">ApexPost Logistics</h1>
        <p>Postal, shipping and retail-counter workflows for your assigned branch.</p>
        <p><a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in</a></p>
        <p class="text-muted">A locally configured staff account is required to access counter workflows.</p>
    </div>
}
