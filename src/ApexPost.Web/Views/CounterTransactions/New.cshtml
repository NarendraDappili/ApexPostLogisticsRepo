@model ApexPost.Web.Models.CounterBasketViewModel
@using ApexPost.Domain.Enums
@{ ViewData["Title"] = "New counter basket"; }
<h1>New counter transaction</h1>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status" aria-live="polite">@notice</div> }
<p class="text-muted">All prices are calculated on the server: retail items from the catalogue, shipments from the configured rates and money orders from the configured fee. Create shipments and money orders with this transaction ID first, then add their IDs here.</p>
<form asp-action="New" method="post">
 <div asp-validation-summary="ModelOnly" class="validation-summary text-danger" role="alert"></div>
 <div class="row g-3">
  <div class="col-md-4"><label asp-for="TransactionId" class="form-label"></label><input asp-for="TransactionId" class="form-control" /><span asp-validation-for="TransactionId" class="field-validation"></span></div>
  <div class="col-md-4"><label asp-for="BranchCode" class="form-label"></label><input asp-for="BranchCode" class="form-control" readonly /><span asp-validation-for="BranchCode" class="field-validation"></span></div>
  <div class="col-md-4"><label asp-for="CounterCode" class="form-label"></label><select asp-for="CounterCode" asp-items="await Lookup.OpenCountersAsync(Model.BranchCode, Context.RequestAborted)" class="form-select"><option value="">Select a counter</option></select><span asp-validation-for="CounterCode" class="field-validation"></span></div>
 </div>
 <div class="row g-3 mt-1"><div class="col-md-4"><label asp-for="PaymentMethod" class="form-label"></label><select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select><span asp-validation-for="PaymentMethod" class="field-validation"></span></div></div>
 <fieldset class="border p-3 mt-3"><legend class="float-none w-auto px-2">Retail items</legend>
  <span asp-validation-for="RetailLines" class="field-validation text-danger"></span>
  @{ var productOptions = await Lookup.ProductsAsync(Context.RequestAborted); }
  @for (var i = 0; i < Model.RetailLines.Count; i++)
  {
   <div class="row g-3 mb-2">
    <div class="col-md-6"><label asp-for="RetailLines[i].ProductId" class="form-label">Product (row @(i + 1))</label><select asp-for="RetailLines[i].ProductId" asp-items="productOptions" class="form-select"><option value="">No product</option></select><span asp-validation-for="RetailLines[i].ProductId" class="field-validation"></span></div>
    <div class="col-md-3"><label asp-for="RetailLines[i].Quantity" class="form-label">Quantity (row @(i + 1))</label><input asp-for="RetailLines[i].Quantity" type="number" min="1" step="1" class="form-control" /><span asp-validation-for="RetailLines[i].Quantity" class="field-validation"></span></div>
   </div>
  }
 </fieldset>
 <fieldset class="border p-3 mt-3"><legend class="float-none w-auto px-2">Services</legend>
  <div class="mb-3"><label asp-for="ShipmentIds" class="form-label">Shipment IDs</label><input asp-for="ShipmentIds" class="form-control" aria-describedby="shipment-help" /><span asp-validation-for="ShipmentIds" class="field-validation"></span><small id="shipment-help" class="form-text">Comma-separated shipments created with this transaction ID.</small></div>
  <div><label asp-for="MoneyOrderIds" class="form-label">Money order IDs</label><input asp-for="MoneyOrderIds" class="form-control" aria-describedby="money-order-help" /><span asp-validation-for="MoneyOrderIds" class="field-validation"></span><small id="money-order-help" class="form-text">Comma-separated money orders issued with this transaction ID. High-value orders must have a verified identity.</small></div>
 </fieldset>
 <button class="btn btn-primary mt-3" type="submit">Pay basket</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
