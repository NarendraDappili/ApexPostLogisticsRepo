@model ApexPost.Web.Models.CounterBasketViewModel
@using ApexPost.Domain.Enums
@{ ViewData["Title"] = "New counter basket"; }
<h1>New counter transaction</h1>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success">@notice</div> }
<p class="text-muted">Retail pricing is taken from the catalogue. Service prices must come from their owning workflow; this form does not calculate rates.</p>
<form asp-action="New" method="post">
 <div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <div class="row"><div class="col-md-3"><label asp-for="TransactionId"></label><input asp-for="TransactionId" class="form-control" /></div><div class="col-md-3"><label asp-for="BranchCode"></label><input asp-for="BranchCode" class="form-control" /></div><div class="col-md-3"><label asp-for="CounterCode"></label><input asp-for="CounterCode" class="form-control" /></div><div class="col-md-3"><label asp-for="ClerkId"></label><input asp-for="ClerkId" class="form-control" /></div></div>
 <div class="row mt-3"><div class="col-md-4"><label asp-for="PaymentMethod"></label><select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select></div></div>
 <fieldset class="border p-3 mt-3"><legend class="float-none w-auto px-2">Retail item</legend><div class="row"><div class="col-md-6"><label asp-for="ProductId"></label><input asp-for="ProductId" class="form-control" /></div><div class="col-md-3"><label asp-for="RetailQuantity"></label><input asp-for="RetailQuantity" class="form-control" /></div></div></fieldset>
 <fieldset class="border p-3 mt-3"><legend class="float-none w-auto px-2">Service line</legend><div class="row"><div class="col-md-5"><label asp-for="ServiceDescription"></label><input asp-for="ServiceDescription" class="form-control" /></div><div class="col-md-3"><label asp-for="ServiceUnitPrice"></label><input asp-for="ServiceUnitPrice" class="form-control" /></div><div class="col-md-2"><label asp-for="ServiceQuantity"></label><input asp-for="ServiceQuantity" class="form-control" /></div></div></fieldset>
 <div class="mt-3"><label asp-for="MoneyOrderIds"></label><input asp-for="MoneyOrderIds" class="form-control" /><small class="form-text">Comma-separated existing money-order IDs for this transaction context.</small></div>
 <button class="btn btn-primary mt-3" type="submit">Pay basket</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
