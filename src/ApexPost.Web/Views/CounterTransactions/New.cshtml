@model ApexPost.Web.Models.CounterBasketViewModel
@using ApexPost.Domain.Enums
@{ ViewData["Title"] = "New counter basket"; }
<h1>New counter transaction</h1>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status" aria-live="polite">@notice</div> }
<p class="text-muted">Retail pricing is taken from the catalogue. Service prices must come from their owning workflow; this form does not calculate rates.</p>
<form asp-action="New" method="post">
 <div asp-validation-summary="ModelOnly" class="validation-summary text-danger" role="alert"></div>
 <div class="row g-3">
  <div class="col-md-4"><label asp-for="TransactionId" class="form-label"></label><input asp-for="TransactionId" class="form-control" /><span asp-validation-for="TransactionId" class="field-validation"></span></div>
  <div class="col-md-4"><label asp-for="BranchCode" class="form-label"></label><input asp-for="BranchCode" class="form-control" readonly /><span asp-validation-for="BranchCode" class="field-validation"></span></div>
  <div class="col-md-4"><label asp-for="CounterCode" class="form-label"></label><input asp-for="CounterCode" class="form-control" /><span asp-validation-for="CounterCode" class="field-validation"></span></div>
 </div>
 <div class="row g-3 mt-1"><div class="col-md-4"><label asp-for="PaymentMethod" class="form-label"></label><select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select><span asp-validation-for="PaymentMethod" class="field-validation"></span></div></div>
 <fieldset class="border p-3 mt-3"><legend class="float-none w-auto px-2">Retail item</legend><div class="row g-3">
  <div class="col-md-6"><label asp-for="ProductId" class="form-label"></label><input asp-for="ProductId" class="form-control" /><span asp-validation-for="ProductId" class="field-validation"></span></div>
  <div class="col-md-3"><label asp-for="RetailQuantity" class="form-label"></label><input asp-for="RetailQuantity" type="number" min="1" step="1" class="form-control" /><span asp-validation-for="RetailQuantity" class="field-validation"></span></div>
 </div></fieldset>
 <fieldset class="border p-3 mt-3"><legend class="float-none w-auto px-2">Service line</legend><div class="row g-3">
  <div class="col-md-5"><label asp-for="ServiceDescription" class="form-label"></label><input asp-for="ServiceDescription" class="form-control" /><span asp-validation-for="ServiceDescription" class="field-validation"></span></div>
  <div class="col-md-3"><label asp-for="ServiceUnitPrice" class="form-label"></label><input asp-for="ServiceUnitPrice" type="number" min="0.01" step="0.01" inputmode="decimal" class="form-control" /><span asp-validation-for="ServiceUnitPrice" class="field-validation"></span></div>
  <div class="col-md-2"><label asp-for="ServiceQuantity" class="form-label"></label><input asp-for="ServiceQuantity" type="number" min="1" step="1" class="form-control" /><span asp-validation-for="ServiceQuantity" class="field-validation"></span></div>
 </div></fieldset>
 <div class="mt-3"><label asp-for="MoneyOrderIds" class="form-label"></label><input asp-for="MoneyOrderIds" class="form-control" aria-describedby="money-order-help" /><span asp-validation-for="MoneyOrderIds" class="field-validation"></span><small id="money-order-help" class="form-text">Comma-separated existing order IDs linked to this transaction context.</small></div>
 <button class="btn btn-primary mt-3" type="submit">Pay basket</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
