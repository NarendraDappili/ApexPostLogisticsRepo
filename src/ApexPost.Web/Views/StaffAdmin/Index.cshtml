@model IReadOnlyList<ApexPost.Application.Queries.StaffListItem>
@{ ViewData["Title"] = "Staff"; }
<h1>Staff</h1>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status" aria-live="polite">@notice</div> }
<p><a class="btn btn-primary" asp-action="Create">Add staff member</a></p>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <caption>All staff members</caption>
        <thead><tr><th scope="col">Staff ID</th><th scope="col">Name</th><th scope="col">Role</th><th scope="col">Home branch</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
        <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <th scope="row" class="text-nowrap">@member.StaffId</th>
                <td><span class="d-block fw-semibold">@member.Name</span><span class="d-block small text-muted">@{ var at = member.Email?.IndexOf('@') ?? -1; }@if (at > 0) { @member.Email![..at]<wbr />@member.Email[at..] } else { @member.Email }</span></td>
                <td>@ApexPost.Web.Services.DisplayText.Of(member.Role)</td>
                <td class="text-nowrap">@member.BranchCode</td>
                <td><span class="badge @(member.IsActive ? "text-bg-success" : "text-bg-secondary")">@(member.IsActive ? "Active" : "Inactive")</span></td>
                <td>
                    @* The cell stays a table cell (so the row's height, borders and striping reach it); the buttons line up inside. *@
                    <div class="table-actions">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@member.StaffId">Edit</a>
                        <form method="post" asp-action="@(member.IsActive ? "Deactivate" : "Activate")" asp-route-id="@member.StaffId">
                            <button class="btn btn-sm @(member.IsActive ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(member.IsActive ? "Deactivate" : "Reactivate")</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
