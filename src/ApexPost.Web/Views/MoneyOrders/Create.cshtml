@model ApexPost.Web.Models.MoneyOrderFormViewModel
@using ApexPost.Domain.Enums
@{ ViewData["Title"] = "Money order"; }
<h1>Money order and identity verification</h1>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success">@notice</div> }
<p class="text-muted">Document numbers are accepted only to create a masked reference; the full value is not persisted.</p>
<form asp-action="Create" method="post" autocomplete="off"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row"><div class="col-md-3"><label asp-for="MoneyOrderId"></label><input asp-for="MoneyOrderId" class="form-control" /></div><div class="col-md-3"><label asp-for="BranchCode"></label><input asp-for="BranchCode" class="form-control" /></div><div class="col-md-3"><label asp-for="Amount"></label><input asp-for="Amount" class="form-control" /></div><div class="col-md-3"><label asp-for="Fee"></label><input asp-for="Fee" class="form-control" /></div></div>
<div class="row mt-3"><div class="col-md-4"><label asp-for="Sender"></label><input asp-for="Sender" class="form-control" /></div><div class="col-md-4"><label asp-for="Recipient"></label><input asp-for="Recipient" class="form-control" /></div><div class="col-md-4"><label asp-for="TransactionContextId"></label><input asp-for="TransactionContextId" class="form-control" /></div></div>
<fieldset class="border p-3 mt-3"><legend class="float-none w-auto px-2">Identity verification (when required)</legend><div class="row"><div class="col-md-4"><label asp-for="DocumentType"></label><input asp-for="DocumentType" class="form-control" /></div><div class="col-md-4"><label asp-for="DocumentNumber"></label><input asp-for="DocumentNumber" type="password" class="form-control" autocomplete="off" /></div><div class="col-md-4"><label asp-for="VerificationOutcome"></label><select asp-for="VerificationOutcome" asp-items="Html.GetEnumSelectList<IdentityVerificationOutcome>()" class="form-select"></select></div></div></fieldset>
<button class="btn btn-primary mt-3">Create money order</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
