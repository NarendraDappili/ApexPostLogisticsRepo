<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A typed C# client for the ApexPost Logistics API, version 2.
    Generated/ApexPostClient.g.cs is generated by NSwag from ../../contracts/v2.json with the settings in nswag.json:

        dotnet tool restore
        dotnet nswag run src/ApexPost.Client/nswag.json

    The NSwag version is pinned in dotnet-tools.json. Never edit the generated file: regenerate it. Hand-written
    additions live in partial classes (ApexPostClient.Partial.cs) and wrappers (ClientRegistration.cs).
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApexPost.Api.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
