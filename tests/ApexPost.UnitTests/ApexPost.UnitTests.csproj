<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit level of the test pyramid (TESTING-STRATEGY.md §3, §4): no database, no files written, no sockets, no
    system clock. Runs with nothing installed: dotnet test tests/ApexPost.UnitTests
    It does not reference ApexPost.Web: the Web and API apps both declare a global Program class (§4.2).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ApexPost.Domain\ApexPost.Domain.csproj" />
    <ProjectReference Include="..\..\src\ApexPost.Application\ApexPost.Application.csproj" />
    <ProjectReference Include="..\..\src\ApexPost.Infrastructure\ApexPost.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ApexPost.Api\ApexPost.Api.csproj" />
    <ProjectReference Include="..\..\src\ApexPost.Client\ApexPost.Client.csproj" />
    <ProjectReference Include="..\..\src\ApexPost.Courier.Offline\ApexPost.Courier.Offline.csproj" />
    <ProjectReference Include="..\..\src\ApexPost.Courier.Core\ApexPost.Courier.Core.csproj" />
  </ItemGroup>

</Project>
